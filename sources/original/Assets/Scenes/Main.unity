    m_PersistentCalls:
      m_Calls: []
  m_text: "The Yellow Fever had struck the village. Any visit to its somber limits
    forced the young heirs to keep a cloth handkerchief about their mouth and nostrils
    to protect themselves from the miasma. This seemed the perfect \u2014 if macabre
    \u2014 backdrop in which to advance their father's dreadful business."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6c75d24910859c34594bade8a0fb945f, type: 2}
  m_sharedMaterial: {fileID: -6565545493437275405, guid: 6c75d24910859c34594bade8a0fb945f,
    type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
