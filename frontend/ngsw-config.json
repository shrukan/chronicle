{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/content/assets/app-icon/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/*.(svg|cur|jpg|jpeg|png|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "content",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/content/*/*.json",
          "/content/ui.en.json",
          "/content/changelog.md",
          "/content/assets/manifest.json",
          "/content/assets/icons/**",
          "/content/assets/ui/**"
        ]
      }
    },
    {
      "name": "pictures-and-sound",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/content/assets/setup/**",
          "/content/assets/audio/**"
        ]
      }
    }
  ]
}
